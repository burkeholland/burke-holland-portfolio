---
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../utils/site";
---

<SiteLayout
  title="Page not found"
  description="The requested page could not be found."
  noIndex={true}
>
  <section class="not-found page-width">
    <p class="eyebrow">404 · Not found</p>
    <h1>This page isn't here.</h1>
    <p class="page-intro__lede">
      The address may have changed, or the page may never have existed.
    </p>
    <a class="button button--primary" href={withBase("/")}>
      Back to the homepage <span aria-hidden="true">↗</span>
    </a>
  </section>
</SiteLayout>
