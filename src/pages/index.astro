---
import SiteLayout from "../layouts/SiteLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import { getPublishedPosts } from "../utils/blog";
import { withBase } from "../utils/site";

const latestPosts = (await getPublishedPosts()).slice(0, 2);
const latestPostsAreExamples =
  latestPosts.length > 0 && latestPosts.every((post) => post.data.example);
---

<SiteLayout
  title="Projects & notes"
  description="Selected public projects, profile links, and a Markdown blog archive for Burke Holland."
  canonicalPath="/"
>
  <section class="hero page-width">
    <div class="hero__copy">
      <p class="eyebrow"><span class="eyebrow__dot"></span> Portfolio & notes</p>
      <h1>Burke Holland</h1>
      <p class="hero__lede">
        Selected projects, profile links, and a Markdown blog archive.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href={withBase("/projects/")}>
          Explore projects <span aria-hidden="true">↗</span>
        </a>
        <a class="button button--quiet" href={profile.githubUrl}>
          Find Burke on GitHub
        </a>
      </div>
    </div>
    <aside class="profile-card" aria-label="Profile details">
      <div class="profile-card__mark" aria-hidden="true">BH</div>
      <p class="profile-card__detail">
        {profile.location}<br />{profile.company}
      </p>
      <p class="profile-card__bio">“{profile.bio}”</p>
      <span class="profile-card__rule" aria-hidden="true"></span>
      <p class="profile-card__caption">Public profile</p>
    </aside>
  </section>

  <section class="section page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Projects</h2>
      </div>
      <a class="text-link" href={withBase("/projects/")}>
        All projects <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index + 1} />)}
    </div>
  </section>

  <section class="section section--writing page-width">
    <div class="section-heading">
      <div>
        <p class="eyebrow">From the archive</p>
        <h2>Latest notes</h2>
      </div>
      <a class="text-link" href={withBase("/blog/")}>
        Visit the blog <span aria-hidden="true">↗</span>
      </a>
    </div>
    {
      latestPostsAreExamples && (
        <p class="section-note">
          The posts below are examples, labeled and credited to Example content.
        </p>
      )
    }
    <div class="post-grid">
      {latestPosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>
</SiteLayout>
